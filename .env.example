# Configuración de la app. Cópiala antes de compilar:
#
#     cp .env.example .env
#
# Este archivo es la ÚNICA fuente de configuración, tanto en desarrollo como
# en producción: para publicar, pon aquí los valores de producción y compila
# normal. No hace falta pasar argumentos a flutter.
#
# El .env es obligatorio: está declarado como asset en pubspec.yaml, así que
# sin él la compilación falla con "No file or variants found for asset: .env".
# Este archivo (.env.example) sí se versiona; el .env no.
#
# Si lo editas, para el proceso y vuelve a arrancar: un hot reload no recarga
# los assets. Si aun así no lo toma: flutter clean && flutter pub get
#
# ⚠️ El .env viaja DENTRO del APK y del IPA, y se puede extraer con `unzip`.
# Aquí solo van claves públicas por diseño; nunca credenciales de servidor.

# URL del backend para el emulador/simulador y para producción.
#   - emulador Android : http://10.0.2.2:8000
#   - simulador iOS    : http://localhost:8000
#   - producción       : https://... (en release DEBE ser https)
API_BASE_URL=http://10.0.2.2:8000

# URL del backend cuando ejecutas la app en un iPhone o Android FÍSICO
# (depuración manual). La app detecta sola si el dispositivo es físico o un
# emulador/simulador, y en un dispositivo físico usa esta variable en vez de
# API_BASE_URL. Pon la IP local de tu Mac en la misma red:
#   ipconfig getifaddr en0
# Si la dejas vacía, cae en API_BASE_URL (que en un teléfono real casi nunca
# es alcanzable) y AppConfig lo avisa por consola.
API_BASE_URL_DEVICE=http://192.168.1.100:8000

# Restringida por bundle ID / SHA-1 en Google Cloud Console.
GOOGLE_MAPS_API_KEY=AIza...
