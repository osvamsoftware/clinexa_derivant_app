# Configuración local de desarrollo.
#
# Se inyecta al COMPILAR con --dart-define-from-file=.env
# (lo hace ./run_dev.sh y la configuración del IDE).
#
# Este archivo NO se declara como asset en pubspec.yaml: si lo fuera,
# viajaría dentro del APK y cualquiera podría extraerlo con `unzip`.
# Tampoco se versiona: está en .gitignore.

# URL del backend. Para un iPhone físico usa la IP de tu Mac.
API_BASE_URL=http://localhost:8000

# Restringida por bundle ID / SHA-1 en Google Cloud Console.
GOOGLE_MAPS_API_KEY=AIza...
