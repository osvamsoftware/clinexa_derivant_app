# Plantilla de configuración. Cópiala antes de compilar:
#
#     cp .env.example .env
#
# El .env es OBLIGATORIO: está declarado como asset en pubspec.yaml, así que
# sin él la compilación falla con "No file or variants found for asset: .env".
# Este archivo (.env.example) sí se versiona; el .env no.
#
# ⚠️ Al ser un asset, el .env viaja DENTRO del APK y del IPA, y se puede
# extraer con `unzip`. Aquí solo van claves públicas; nunca credenciales de
# servidor.
#
# Para un build de producción sin claves dentro del paquete, deja el .env
# vacío y pasa los valores con --dart-define (tienen prioridad sobre el .env):
#
#     flutter build appbundle --release \
#       --dart-define=API_BASE_URL=https://api.clinexapp.com \
#       --dart-define=GOOGLE_MAPS_API_KEY=...

# URL del backend. Para un iPhone físico usa la IP de tu Mac.
API_BASE_URL=http://localhost:8000

# Restringida por bundle ID / SHA-1 en Google Cloud Console.
GOOGLE_MAPS_API_KEY=AIza...
