<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Clinexapp Conecta</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>clinexa_derivant_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- App Transport Security.

	     NSAllowsArbitraryLoads permitía HTTP en claro contra CUALQUIER
	     servidor, lo que anula la protección de transporte de iOS y obliga a
	     justificarlo ante la revisión de la App Store.

	     NSAllowsLocalNetworking permite solo lo que hace falta en desarrollo:
	     hablar con un backend en la red local (http://192.168.x.x:8000).
	     Todo lo que salga a internet sigue exigiendo HTTPS. -->
	<!-- Depuracion inalambrica: el `flutter run` descubre el Dart VM Service
	     del dispositivo por mDNS/Bonjour, y desde iOS 14 eso exige declarar
	     el servicio y un texto de permiso. Sin estas dos claves la app se
	     instala y arranca, pero se queda en blanco y el comando termina con
	     "The Dart VM Service was not discovered after 75 seconds".
	     El VM Service no existe en release, asi que en produccion el permiso
	     nunca se pide. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Permite que las herramientas de Flutter en tu computadora se conecten a la app para depurarla.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_dartVmService._tcp</string>
		<string>_dartobservatory._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>La aplicación necesita acceso a la galería para permitir al usuario seleccionar imágenes cuando sea necesario.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Declaracion de cumplimiento de exportacion de criptografia.

	     La app solo usa HTTPS y el llavero del sistema, que son exenciones
	     estandar; no implementa criptografia propia. Declararlo aqui evita
	     que App Store Connect pregunte por ello en cada subida y deje la
	     build bloqueada hasta responder.

	     Si algun dia se anade cifrado propio en el cliente, hay que revisar
	     esta declaracion. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
