<?xml version="1.0" encoding="utf-8"?>
<!--
  Política de red de la app.

  - Se prohíbe el tráfico en claro de forma global: todo debe ir por HTTPS.
  - Se permite HTTP solo contra las direcciones de desarrollo local
    (emulador y localhost), que nunca salen del equipo, y contra el EC2 de
    staging, que sirve la API por http en una IP publica.
    QUITAR la IP del EC2 antes de compilar la release de produccion.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- EC2 de staging: solo para pruebas, no para produccion. -->
        <domain includeSubdomains="false">18.222.50.135</domain>
    </domain-config>
</network-security-config>
